  "target": "label",
  "label_mapping": {
    "0": "Baik",
    "1": "Perlu Perbaikan"
  },
  "threshold": 0.49,
  "pytorch_version": "2.14.1+cpu",
  "numpy_version": "2.5.3",
  "sklearn_version": "1.9.1"
}